# Copy to .env and edit. Docker Compose reads this file.

# Windows path to Hytale install (forward slashes work with Docker Desktop)
HYTALE_HOST_PATH=C:/Users/REPLACE_ME/AppData/Roaming/Hytale

BRAIN_PORT=8766
API_PORT=8780
SIM_MODE=0

# --- Local Qwen (default) — model files live in ./models/ollama ---
# Served by docker service "ollama"; pull with: .\scripts\pull-qwen.ps1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_PORT=11434
# Higher quality / slower on CPU: OLLAMA_MODEL=qwen2.5:7b

# Cloud LLM optional (not used when Ollama is set)
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

NPC_NAME=Pest
