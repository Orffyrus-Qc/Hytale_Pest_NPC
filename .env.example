# Copy to .env and edit. Docker Compose reads this file.

# Windows path to Hytale install (forward slashes work with Docker Desktop)
# Default on most machines:
HYTALE_HOST_PATH=C:/Users/REPLACE_ME/AppData/Roaming/Hytale

# Ports published on host
BRAIN_PORT=8766
API_PORT=8780

# 1 = run without a live Hytale plugin (synthetic demos for testing)
# 0 = real game learning only (recommended). 1 = synthetic sim loop (dev only).
SIM_MODE=0

# Optional LLM (dialogue + higher-level plan narration). Leave empty for rule/policy-only mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional local Ollama (host): http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# NPC identity
NPC_NAME=Pest
